{
  "name": "Olist Portfolio",
  "dataColors": ["#2563eb", "#f59e0b", "#dc2626", "#94a3b8", "#0d9488", "#7c3aed", "#ea580c", "#16a34a"],
  "background": "#ffffff",
  "foreground": "#1e293b",
  "tableAccent": "#2563eb",
  "good": "#16a34a",
  "neutral": "#f59e0b",
  "bad": "#dc2626",
  "maximum": "#2563eb",
  "center": "#f59e0b",
  "minimum": "#dc2626",
  "null": "#cbd5e1",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#1e293b" },
    "title":   { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#1e293b" },
    "header":  { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1e293b" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#475569" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#ffffff" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#e2e8f0" } }, "radius": 8 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1e293b" } }, "fontSize": 13, "alignment": "left" }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#f1f5f9" } }, "transparency": 0 }]
      }
    }
  }
}
